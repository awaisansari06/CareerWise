# Copy into your hosting provider's environment; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/careerwise?sslmode=require
# Optional direct endpoint for production migrations; app runtime keeps DATABASE_URL.
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT-HOST:5432/careerwise?sslmode=require
NEXT_PUBLIC_APP_URL=https://YOUR-PRODUCTION-DOMAIN
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
GEMINI_API_KEY=REPLACE_ME
# Select a model available to your Google project.
GEMINI_MODEL=REPLACE_WITH_SUPPORTED_MODEL
AI_HOURLY_LIMIT=30
INNGEST_EVENT_KEY=REPLACE_ME
INNGEST_SIGNING_KEY=REPLACE_ME
CLERK_WEBHOOK_SIGNING_SECRET=REPLACE_ME
